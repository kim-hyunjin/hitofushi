---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/Eyebrow';
import PageShell from '@/components/PageShell.astro';
import { Button } from '@/components/starwind/button';
import { Card } from '@/components/starwind/card';
import { getOrderedLessons } from '@/lib/content';
import { withBase } from '@/lib/paths';
import { songs } from '@/lib/songs';

const lessons = await getOrderedLessons();
const songCards = songs.map((song) => {
  const songLessons = lessons.filter((entry) => entry.data.songSlug === song.slug);
  return {
    ...song,
    lessonCount: songLessons.length,
    sentenceCount: songLessons.reduce(
      (total, entry) => total + entry.data.sentences.length,
      0,
    ),
    vocabularyCount: songLessons.reduce(
      (total, entry) => total + entry.data.vocabulary.length,
      0,
    ),
    estimatedMinutes: songLessons.reduce(
      (total, entry) => total + entry.data.estimatedMinutes,
      0,
    ),
  };
});
---

<BaseLayout
  title="노래 목록"
  description="노래 가사로 일본어를 공부할 수 있는 곡과 단원 목록"
>
  <section class="bg-[var(--hero)] py-18 text-[var(--hero-foreground)]">
    <PageShell>
      <Eyebrow tone="hero">SONG LIBRARY</Eyebrow>
      <h1 class="mb-[1.2rem] max-w-[12ch] text-[length:clamp(2.8rem,10vw,5.4rem)] font-medium leading-[1.05] tracking-[-0.06em] [font-family:Georgia,'Noto_Serif_KR',serif]">노래로 시작하는<br />일본어 공부</h1>
      <p class="mb-0 max-w-136 text-[var(--on-ink-soft)]">
        한 곡의 감정과 이야기를 따라가며 가사, 문법, 어휘와 한자를
        차근차근 익혀 보세요.
      </p>
    </PageShell>
  </section>

  <PageShell as="section" class="py-16 pb-20" aria-labelledby="song-list-title">
    <div class="mb-8 max-w-152">
      <Eyebrow>학습 가능한 노래</Eyebrow>
      <h2
        id="song-list-title"
        class="mb-[0.7rem] text-[length:clamp(1.7rem,6vw,2.7rem)] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]"
      >지금 만날 수 있는 곡</h2>
    </div>

    <div class="grid gap-5">
      {
        songCards.map((song) => (
          <Card
            class="grid gap-6 rounded-xl border border-border bg-card p-6 shadow-[var(--shadow)] md:grid-cols-[4rem_1fr_auto] md:items-start md:p-8 [&_[data-slot=button]]:self-end"
            role="article"
          >
            <div class="text-[2.4rem] text-accent [font-family:Georgia,serif]" aria-hidden="true">
              {String(song.sequence).padStart(2, '0')}
            </div>
            <div>
              <span class="text-xs font-extrabold text-muted-foreground">{song.artist} · 전곡 과정</span>
              <h3 class="mb-[0.7rem] mt-1 text-[length:clamp(2.5rem,8vw,4.4rem)] font-medium italic tracking-[-0.05em] [font-family:Georgia,serif]">{song.title}</h3>
              <p class="max-w-168 text-muted-foreground">{song.description}</p>
              <dl class="m-0 mt-6 grid grid-cols-2 gap-[0.6rem] md:grid-cols-4 [&_div]:rounded-xl [&_div]:bg-muted [&_div]:p-[0.8rem] [&_dt]:text-[0.68rem] [&_dt]:font-extrabold [&_dt]:text-muted-foreground [&_dd]:mb-0 [&_dd]:ml-0 [&_dd]:mt-[0.1rem] [&_dd]:text-[1.2rem] [&_dd]:[font-family:Georgia,serif]">
                <div>
                  <dt>단원</dt>
                  <dd>{song.lessonCount}</dd>
                </div>
                <div>
                  <dt>문장</dt>
                  <dd>{song.sentenceCount}</dd>
                </div>
                <div>
                  <dt>어휘</dt>
                  <dd>{song.vocabularyCount}</dd>
                </div>
                <div>
                  <dt>학습 시간</dt>
                  <dd>약 {song.estimatedMinutes}분</dd>
                </div>
              </dl>
            </div>
            <Button href={withBase(`/songs/${song.slug}/`)}>
              학습 과정 보기 <span aria-hidden="true">→</span>
            </Button>
          </Card>
        ))
      }
    </div>
  </PageShell>
</BaseLayout>
