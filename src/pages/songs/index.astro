---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const vintageLessons = (await getCollection('lessons'))
  .filter((entry) => entry.data.songSlug === 'vintage')
  .sort((a, b) => a.data.lessonNumber - b.data.lessonNumber);

const sentenceCount = vintageLessons.reduce(
  (total, entry) => total + entry.data.sentences.length,
  0,
);
const vocabularyCount = vintageLessons.reduce(
  (total, entry) => total + entry.data.vocabulary.length,
  0,
);
const estimatedMinutes = vintageLessons.reduce(
  (total, entry) => total + entry.data.estimatedMinutes,
  0,
);
---

<BaseLayout
  title="노래 목록"
  description="J-POP 가사로 일본어를 공부할 수 있는 노래와 단원 목록"
>
  <section class="catalog-hero">
    <div class="shell">
      <p class="eyebrow">SONG LIBRARY</p>
      <h1>노래로 시작하는<br />일본어 공부</h1>
      <p>
        한 곡의 감정과 이야기를 따라가며 가사, 문법, 어휘와 한자를
        차근차근 익혀 보세요.
      </p>
    </div>
  </section>

  <section class="shell catalog-section" aria-labelledby="song-list-title">
    <div class="section-intro">
      <p class="eyebrow">학습 가능한 노래</p>
      <h2 id="song-list-title">지금 만날 수 있는 곡</h2>
    </div>

    <article class="song-card">
      <div class="song-number" aria-hidden="true">01</div>
      <div class="song-copy">
        <span>J-POP 일본어 · 전곡 과정</span>
        <h3>Vintage</h3>
        <p>
          상처를 피하던 마음이 함께 쌓은 시간과 기억을 사랑하게 되는 흐름을
          일곱 단원으로 읽습니다.
        </p>
        <dl>
          <div>
            <dt>단원</dt>
            <dd>{vintageLessons.length}</dd>
          </div>
          <div>
            <dt>문장</dt>
            <dd>{sentenceCount}</dd>
          </div>
          <div>
            <dt>어휘</dt>
            <dd>{vocabularyCount}</dd>
          </div>
          <div>
            <dt>학습 시간</dt>
            <dd>약 {estimatedMinutes}분</dd>
          </div>
        </dl>
      </div>
      <a class="primary-link" href={withBase('/songs/vintage/')}>
        학습 과정 보기 <span aria-hidden="true">→</span>
      </a>
    </article>
  </section>
</BaseLayout>

<style>
  .catalog-hero {
    padding: 4.5rem 0;
    background: var(--ink);
    color: var(--white);
  }

  .catalog-hero :global(.eyebrow) {
    color: var(--yellow);
  }

  .catalog-hero h1 {
    max-width: 12ch;
    margin-bottom: 1.2rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2.8rem, 10vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .catalog-hero p:last-child {
    max-width: 34rem;
    margin-bottom: 0;
    color: #c7d0d8;
  }

  .catalog-section {
    padding: 4rem 0 5rem;
  }

  .song-card {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .song-number {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 2.4rem;
  }

  .song-copy > span {
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .song-copy h3 {
    margin: 0.25rem 0 0.7rem;
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 8vw, 4.4rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .song-copy > p {
    max-width: 42rem;
    color: var(--ink-soft);
  }

  .song-copy dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 1.5rem 0 0;
  }

  .song-copy dl div {
    padding: 0.8rem;
    border-radius: 0.75rem;
    background: #f0ede5;
  }

  .song-copy dt {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .song-copy dd {
    margin: 0.1rem 0 0;
    font-family: Georgia, serif;
    font-size: 1.2rem;
  }

  .song-card :global(.primary-link) {
    align-self: end;
  }

  @media (min-width: 48rem) {
    .song-card {
      grid-template-columns: 4rem 1fr auto;
      align-items: start;
      padding: 2rem;
    }

    .song-copy dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
