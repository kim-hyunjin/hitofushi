---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/paths';

const lessons = await getCollection('lessons');
const grammarEntries = await getCollection('grammar');
const vintageLessons = lessons
  .filter((entry) => entry.data.songSlug === 'vintage')
  .sort((a, b) => a.data.lessonNumber - b.data.lessonNumber);
const grammarMap = new Map(
  grammarEntries.map((entry) => [entry.id, entry.data.title]),
);

if (!vintageLessons.length) {
  throw new Error('Vintage lesson content is missing');
}
---

<BaseLayout
  title="Vintage"
  description="Vintage 가사로 배우는 J-POP 일본어 첫 번째 학습 과정"
>
  <section class="song-hero">
    <div class="shell song-hero-inner">
      <div>
        <a class="breadcrumb" href={withBase('/')}>홈</a>
        <p class="eyebrow">SONG 01</p>
        <h1>Vintage</h1>
        <p class="song-kicker">조심스럽게 살아온 마음을 읽는 네 줄</p>
      </div>
      <div class="song-disc" aria-hidden="true">
        <span>あ</span>
      </div>
    </div>
  </section>

  <section class="shell song-overview">
    <div class="section-intro">
      <p class="eyebrow">학습 안내</p>
      <h2>일곱 단원으로 읽는 한 곡</h2>
      <p>
        상처를 피하던 마음이 함께 쌓은 시간을 사랑하게 되는 흐름을 따라
        핵심 문법과 어휘, 한자를 차근차근 익힙니다.
      </p>
    </div>

    <div class="lesson-list">
      {
        vintageLessons.map((lesson) => {
          const grammarIds = [
            ...new Set(lesson.data.sentences.flatMap((sentence) => sentence.grammarIds)),
          ].slice(0, 4);

          return (
            <article class="lesson-list-card">
              <div class="lesson-index">
                {String(lesson.data.lessonNumber).padStart(2, '0')}
              </div>
              <div class="lesson-summary">
                <span>
                  약 {lesson.data.estimatedMinutes}분 · {lesson.data.sentences.length}문장
                </span>
                <h3>{lesson.data.title}</h3>
                <p>{lesson.data.description}</p>
                <div class="lesson-tags">
                  {grammarIds.map((id) => <span>{grammarMap.get(id) ?? id}</span>)}
                </div>
              </div>
              <a
                class="primary-link"
                href={withBase(`/songs/vintage/lessons/${lesson.data.lessonNumber}/`)}
              >
                단원 시작 <span aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .song-hero {
    overflow: hidden;
    padding: 3.5rem 0;
    background: var(--ink);
    color: var(--white);
  }

  .song-hero :global(.breadcrumb) {
    color: #b9c6d0;
  }

  .song-hero :global(.eyebrow) {
    color: var(--yellow);
  }

  .song-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .song-hero h1 {
    margin-bottom: 0.6rem;
    font-family: Georgia, serif;
    font-size: clamp(3.6rem, 16vw, 7rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .song-kicker {
    margin-bottom: 0;
    color: #c7d0d8;
  }

  .song-disc {
    display: none;
    width: 14rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        var(--paper) 0 9%,
        transparent 10% 18%,
        rgb(255 255 255 / 16%) 19% 20%,
        transparent 21%
      ),
      repeating-radial-gradient(circle, #203e59 0 4px, #19344d 5px 8px);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 25%);
  }

  .song-disc span {
    display: grid;
    width: 2.6rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
  }

  .song-overview {
    padding: 4rem 0 5rem;
  }

  .lesson-list {
    display: grid;
    gap: 1rem;
  }

  .lesson-list-card {
    display: grid;
    gap: 1.2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .lesson-index {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 2rem;
  }

  .lesson-summary > span {
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 750;
  }

  .lesson-summary h3 {
    margin: 0.3rem 0;
    font-size: 1.4rem;
  }

  .lesson-summary p {
    color: var(--ink-soft);
  }

  .lesson-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lesson-tags span {
    padding: 0.3rem 0.6rem;
    border-radius: 99rem;
    background: var(--accent-pale);
    color: #7c2d20;
    font-size: 0.75rem;
    font-weight: 750;
  }

  @media (min-width: 42rem) {
    .song-disc {
      display: grid;
    }

    .lesson-list-card {
      grid-template-columns: 4rem 1fr auto;
      align-items: center;
      padding: 2rem;
    }
  }
</style>
