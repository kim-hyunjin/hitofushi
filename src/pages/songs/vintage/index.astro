---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/paths';

const lessons = await getCollection('lessons');
const lesson = lessons.find((entry) => entry.id === 'vintage-1');

if (!lesson) {
  throw new Error('vintage-1 lesson content is missing');
}
---

<BaseLayout
  title="Vintage"
  description="Vintage 가사로 배우는 J-POP 일본어 첫 번째 학습 과정"
>
  <section class="song-hero">
    <div class="shell song-hero-inner">
      <div>
        <a class="breadcrumb" href={withBase('/')}>홈</a>
        <p class="eyebrow">SONG 01</p>
        <h1>Vintage</h1>
        <p class="song-kicker">조심스럽게 살아온 마음을 읽는 네 줄</p>
      </div>
      <div class="song-disc" aria-hidden="true">
        <span>あ</span>
      </div>
    </div>
  </section>

  <section class="shell song-overview">
    <div class="section-intro">
      <p class="eyebrow">학습 안내</p>
      <h2>짧지만 촘촘한 첫 단원</h2>
      <p>
        부정형, 이유, 명사화, 대비 표현을 한 흐름 안에서 만나고
        문장에 등장하는 핵심 한자까지 연결합니다.
      </p>
    </div>

    <article class="lesson-list-card">
      <div class="lesson-index">01</div>
      <div class="lesson-summary">
        <span>약 {lesson.data.estimatedMinutes}분 · 입문</span>
        <h3>{lesson.data.title}</h3>
        <p>{lesson.data.description}</p>
        <div class="lesson-tags">
          <span>〜たくもない</span>
          <span>〜のは</span>
          <span>〜けど</span>
          <span>〜くて</span>
        </div>
      </div>
      <a class="primary-link" href={withBase('/songs/vintage/lessons/1/')}>
        단원 시작 <span aria-hidden="true">→</span>
      </a>
    </article>
  </section>
</BaseLayout>
