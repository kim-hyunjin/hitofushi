---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ReadingControls from '../../../../components/ReadingControls';
import SentenceCard from '../../../../components/SentenceCard.astro';
import VocabularySection from '../../../../components/VocabularySection.astro';
import Quiz from '../../../../components/Quiz';
import Flashcards from '../../../../components/Flashcards';
import ProgressPanel from '../../../../components/ProgressPanel';
import { withBase } from '../../../../lib/paths';

const [lessons, grammarEntries, kanjiEntries] = await Promise.all([
  getCollection('lessons'),
  getCollection('grammar'),
  getCollection('kanji'),
]);

const lessonEntry = lessons.find((entry) => entry.id === 'vintage-1');
if (!lessonEntry) throw new Error('vintage-1 lesson content is missing');

const lesson = lessonEntry.data;
const grammarMap = new Map(
  grammarEntries.map((entry) => [entry.id, entry.data.title]),
);
const lessonGrammarIds = [...new Set(lesson.sentences.flatMap((item) => item.grammarIds))];
const missingGrammarIds = lessonGrammarIds.filter((id) => !grammarMap.has(id));
if (missingGrammarIds.length) {
  throw new Error(`Missing grammar content: ${missingGrammarIds.join(', ')}`);
}

const kanjiMap = new Map(
  kanjiEntries.map((entry) => [entry.data.character, entry]),
);
const lessonKanji = lesson.sentences.flatMap((item) => item.kanjiIds);
const missingKanjiIds = [...new Set(lessonKanji)].filter((id) => !kanjiMap.has(id));
if (missingKanjiIds.length) {
  throw new Error(`Missing kanji content: ${missingKanjiIds.join(', ')}`);
}
const orderedKanji = [...new Set(lessonKanji)].map((character) => kanjiMap.get(character)!);
---

<BaseLayout title={lesson.title} description={lesson.description}>
  <section class="lesson-hero">
    <div class="shell">
      <a class="breadcrumb" href={withBase('/songs/vintage/')}>Vintage</a>
      <div class="lesson-title-row">
        <div>
          <p class="eyebrow">LESSON {String(lesson.lessonNumber).padStart(2, '0')}</p>
          <h1>{lesson.title}</h1>
          <p>{lesson.subtitle}</p>
        </div>
        <div class="lesson-time">
          <strong>{lesson.estimatedMinutes}</strong>
          <span>분 코스</span>
        </div>
      </div>
    </div>
  </section>

  <div class="shell lesson-layout">
    <div class="lesson-main">
      <ReadingControls client:load />

      <section class="lesson-section" aria-labelledby="lyrics-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">가사 읽기</p>
            <h2 id="lyrics-title">네 문장을 내 속도로</h2>
          </div>
          <p>읽기 모드에서는 한자에 마우스를 올리거나 초점을 맞춰 읽기를 확인하세요.</p>
        </div>
        <div class="sentence-list">
          {
            lesson.sentences.map((sentence, index) => (
              <SentenceCard
                sentence={sentence}
                number={index + 1}
                grammar={sentence.grammarIds.map((id) => ({
                  id,
                  label: grammarMap.get(id) ?? id,
                }))}
              />
            ))
          }
        </div>
      </section>

      <section class="lesson-section" aria-labelledby="vocabulary-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">주요 어휘</p>
            <h2 id="vocabulary-title">문장 안에서 단어 익히기</h2>
          </div>
          <p>별표를 눌러 이 기기에 즐겨찾기를 남길 수 있어요.</p>
        </div>
        <VocabularySection items={lesson.vocabulary} />
      </section>

      <section class="split-study-section">
        <div>
          <div class="section-heading compact">
            <div>
              <p class="eyebrow">플래시카드</p>
              <h2>뜻이 바로 떠오르나요?</h2>
            </div>
          </div>
          <Flashcards items={lesson.vocabulary} client:visible />
        </div>
        <div>
          <div class="section-heading compact">
            <div>
              <p class="eyebrow">한자 노트</p>
              <h2>이번 단원의 15자</h2>
            </div>
          </div>
          <div class="kanji-grid">
            {
              orderedKanji.map((entry) => (
                <a href={withBase(`/kanji/${entry.data.character}/`)}>
                  <strong lang="ja">{entry.data.character}</strong>
                  <span>{entry.data.basicMeaning.split(',')[0]}</span>
                </a>
              ))
            }
          </div>
          <p class="mnemonic-notice">
            각 상세 페이지의 연상법은 학습용 기억 장치이며 실제 어원 설명이 아닙니다.
          </p>
        </div>
      </section>

      <section class="lesson-section quiz-section" aria-labelledby="quiz-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">마무리 퀴즈</p>
            <h2 id="quiz-title">표현을 제대로 만났는지 확인해요</h2>
          </div>
          <p>최고 점수는 이 기기에 자동 저장됩니다.</p>
        </div>
        <Quiz lessonId="vintage-1" questions={lesson.quiz} client:visible />
      </section>

      <section class="lesson-section grammar-index" aria-labelledby="grammar-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">문법 색인</p>
            <h2 id="grammar-title">이 단원의 표현 한눈에 보기</h2>
          </div>
        </div>
        <div class="grammar-link-grid">
          {
            lessonGrammarIds.map((id, index) => (
              <a href={withBase(`/grammar/${id}/`)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{grammarMap.get(id) ?? id}</strong>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <div class="lesson-sidebar">
      <ProgressPanel
        lessonId="vintage-1"
        sentenceCount={lesson.sentences.length}
        client:idle
      />
    </div>
  </div>
</BaseLayout>
