---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AspectRatio } from '@/components/starwind/aspect-ratio';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';
import { Button } from '@/components/starwind/button';
import Eyebrow from '@/components/Eyebrow';
import PageShell from '@/components/PageShell.astro';
import ReadingControls from '@/components/ReadingControls';
import SentenceCard from '@/components/SentenceCard.astro';
import VocabularySection from '@/components/VocabularySection.astro';
import Quiz from '@/components/Quiz';
import Flashcards from '@/components/Flashcards';
import ProgressPanel from '@/components/ProgressPanel';
import GrammarPopover from '@/components/GrammarPopover.astro';
import KanjiPopover from '@/components/KanjiPopover.astro';
import { withBase } from '@/lib/paths';
import { getSong } from '@/lib/songs';
import { getLessonReferences } from '@/lib/content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons
    .map((lessonEntry) => ({
      params: {
        songSlug: lessonEntry.data.songSlug,
        lessonNumber: String(lessonEntry.data.lessonNumber),
      },
      props: { lessonEntry },
    }));
}

interface Props {
  lessonEntry: CollectionEntry<'lessons'>;
}

const { lessonEntry } = Astro.props;
const { grammarMap, kanjiMap } = await getLessonReferences();

const lesson = lessonEntry.data;
const song = getSong(lesson.songSlug);
if (!song) {
  throw new Error(`Missing song metadata: ${lesson.songSlug}`);
}
const lessonGrammarIds = [...new Set(lesson.sentences.flatMap((item) => item.grammarIds))];
const missingGrammarIds = lessonGrammarIds.filter((id) => !grammarMap.has(id));
if (missingGrammarIds.length) {
  throw new Error(`Missing grammar content: ${missingGrammarIds.join(', ')}`);
}

const lessonKanji = lesson.sentences.flatMap((item) => item.kanjiIds);
const missingKanjiIds = [...new Set(lessonKanji)].filter((id) => !kanjiMap.has(id));
if (missingKanjiIds.length) {
  throw new Error(`Missing kanji content: ${missingKanjiIds.join(', ')}`);
}
const orderedKanji = [...new Set(lessonKanji)].map((character) => kanjiMap.get(character)!);
const youtubeWatchUrl = `https://www.youtube.com/watch?v=${song.youtubeVideoId}`;
const youtubeEmbedUrl = `https://www.youtube-nocookie.com/embed/${song.youtubeVideoId}`;
---

<BaseLayout title={lesson.title} description={lesson.description}>
  <section class="bg-[var(--hero)] py-10 pb-12 text-[var(--hero-foreground)]">
    <PageShell>
      <Breadcrumb class="mb-5 text-[var(--on-ink-soft)]">
        <BreadcrumbList>
          <BreadcrumbItem><BreadcrumbLink href={withBase(`/songs/${song.slug}/`)}>{song.title}</BreadcrumbLink></BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem><BreadcrumbPage class="text-[var(--hero-foreground)]">단원 {lesson.lessonNumber}</BreadcrumbPage></BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      <div class="flex items-end justify-between gap-4">
        <div>
          <Eyebrow tone="hero">LESSON {String(lesson.lessonNumber).padStart(2, '0')}</Eyebrow>
          <h1 class="mb-[0.35rem] text-[length:clamp(2.2rem,9vw,4.3rem)] font-medium leading-[1.08] tracking-[-0.055em] [font-family:Georgia,'Noto_Serif_KR',serif]">{lesson.title}</h1>
          <p class="mb-0 text-[var(--on-ink-soft)]">{lesson.subtitle}</p>
        </div>
        <div class="hidden text-center min-[42rem]:block">
          <strong class="block text-[3.5rem] leading-none text-[var(--yellow)] [font-family:Georgia,serif]">{lesson.estimatedMinutes}</strong>
          <span class="block text-xs">분 코스</span>
        </div>
      </div>
    </PageShell>
  </section>

  <PageShell class="py-6 pb-20 lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-12 lg:pt-8">
    <div class="min-w-0">
      <ReadingControls client:load />

      <section class="mb-[4.7rem] mt-6" aria-labelledby="song-player-title">
        <div class="mb-4 flex items-end justify-between gap-4 max-[31.99rem]:flex-col max-[31.99rem]:items-start">
          <div>
            <Eyebrow>곡 듣기</Eyebrow>
            <h2 id="song-player-title" class="mb-0 text-[1.6rem] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">{song.title} 들으며 익히기</h2>
          </div>
          <Button class="shrink-0 text-[0.78rem] font-bold text-muted-foreground underline underline-offset-[0.2em]" variant="ghost" size="sm" href={youtubeWatchUrl} target="_blank" rel="noopener noreferrer">
            YouTube에서 보기
          </Button>
        </div>
        <AspectRatio
          ratio={16 / 9}
          class="overflow-hidden rounded-lg bg-[var(--hero)] shadow-[0_1rem_2.5rem_rgb(27_36_43_/_12%)]"
        >
          <iframe
            class="absolute inset-0 size-full border-0"
            src={youtubeEmbedUrl}
            title={`${song.artist} - ${song.title} 공식 유튜브 영상`}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </AspectRatio>
      </section>

      <section class="mb-[4.7rem]" aria-label="가사 읽기">
        <div class="grid gap-4">
          {
            lesson.sentences.map((sentence, index) => (
              <SentenceCard
                sentence={sentence}
                number={index + 1}
                grammar={sentence.grammarIds.map((id) => grammarMap.get(id)!)}
                kanji={sentence.kanjiIds.map((character) => kanjiMap.get(character)!)}
              />
            ))
          }
        </div>
      </section>

      <section class="mb-[4.7rem]" aria-labelledby="vocabulary-title">
        <div class="mb-6 min-[42rem]:flex min-[42rem]:items-end min-[42rem]:justify-between min-[42rem]:gap-4">
          <div>
            <Eyebrow>주요 어휘</Eyebrow>
            <h2 id="vocabulary-title" class="mb-[0.7rem] text-[length:clamp(1.7rem,6vw,2.7rem)] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">문장 안에서 단어 익히기</h2>
          </div>
          <p class="mb-0 max-w-112 text-[0.84rem] text-muted-foreground">별표를 눌러 이 기기에 즐겨찾기를 남길 수 있어요.</p>
        </div>
        <VocabularySection items={lesson.vocabulary} />
      </section>

      <section class="mb-[4.7rem] grid gap-14 min-[42rem]:grid-cols-2 min-[42rem]:gap-8">
        <div>
          <div class="mb-4">
            <div>
              <Eyebrow>플래시카드</Eyebrow>
              <h2 class="mb-[0.7rem] text-[1.6rem] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">뜻이 바로 떠오르나요?</h2>
            </div>
          </div>
          <Flashcards items={lesson.vocabulary} client:visible />
        </div>
        <div>
          <div class="mb-4">
            <div>
              <Eyebrow>한자 노트</Eyebrow>
              <h2 class="mb-[0.7rem] text-[1.6rem] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">이번 단원의 {orderedKanji.length}자</h2>
            </div>
          </div>
          <div class="grid grid-cols-5 overflow-hidden rounded-lg border border-border bg-card">
            {
              orderedKanji.map((entry, index) => (
                <KanjiPopover
                  entry={entry}
                  popoverId={`${lessonEntry.id}-kanji-index-${index}`}
                  variant="grid"
                />
              ))
            }
          </div>
          <p class="mt-[0.8rem] text-xs text-muted-foreground">
            팝오버의 연상법은 학습용 기억 장치이며 실제 어원 설명이 아닙니다.
          </p>
        </div>
      </section>

      <section class="mb-[4.7rem] rounded-xl bg-[color-mix(in_srgb,var(--secondary)_58%,var(--background))] p-[1.3rem] min-[42rem]:p-8" aria-labelledby="quiz-title">
        <div class="mb-6 min-[42rem]:flex min-[42rem]:items-end min-[42rem]:justify-between min-[42rem]:gap-4">
          <div>
            <Eyebrow>마무리 퀴즈</Eyebrow>
            <h2 id="quiz-title" class="mb-[0.7rem] text-[length:clamp(1.7rem,6vw,2.7rem)] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">표현을 제대로 만났는지 확인해요</h2>
          </div>
          <p class="mb-0 max-w-112 text-[0.84rem] text-muted-foreground">최고 점수는 이 기기에 자동 저장됩니다.</p>
        </div>
        <Quiz lessonId={lessonEntry.id} questions={lesson.quiz} client:visible />
      </section>

      <section class="mb-[4.7rem]" aria-labelledby="grammar-title">
        <div class="mb-6 min-[42rem]:flex min-[42rem]:items-end min-[42rem]:justify-between min-[42rem]:gap-4">
          <div>
            <Eyebrow>문법 색인</Eyebrow>
            <h2 id="grammar-title" class="mb-[0.7rem] text-[length:clamp(1.7rem,6vw,2.7rem)] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">이 단원의 표현 한눈에 보기</h2>
          </div>
        </div>
        <div class="grid border-t border-foreground">
          {
            lessonGrammarIds.map((id, index) => (
              <GrammarPopover
                entry={grammarMap.get(id)!}
                popoverId={`${lessonEntry.id}-grammar-index-${index}`}
                variant="index"
                sequence={String(index + 1).padStart(2, '0')}
              />
            ))
          }
        </div>
      </section>
    </div>

    <div class="lg:order-2">
      <ProgressPanel
        lessonId={lessonEntry.id}
        sentenceIds={lesson.sentences.map((sentence) => sentence.id)}
        client:idle
      />
    </div>
  </PageShell>
</BaseLayout>
