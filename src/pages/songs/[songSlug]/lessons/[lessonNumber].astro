---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ReadingControls from '../../../../components/ReadingControls';
import SentenceCard from '../../../../components/SentenceCard.astro';
import VocabularySection from '../../../../components/VocabularySection.astro';
import Quiz from '../../../../components/Quiz';
import Flashcards from '../../../../components/Flashcards';
import ProgressPanel from '../../../../components/ProgressPanel';
import GrammarPopover from '../../../../components/GrammarPopover.astro';
import KanjiPopover from '../../../../components/KanjiPopover.astro';
import { withBase } from '../../../../lib/paths';
import { getSong } from '../../../../lib/songs';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons
    .map((lessonEntry) => ({
      params: {
        songSlug: lessonEntry.data.songSlug,
        lessonNumber: String(lessonEntry.data.lessonNumber),
      },
      props: { lessonEntry },
    }));
}

interface Props {
  lessonEntry: CollectionEntry<'lessons'>;
}

const { lessonEntry } = Astro.props;
const [grammarEntries, kanjiEntries] = await Promise.all([
  getCollection('grammar'),
  getCollection('kanji'),
]);

const lesson = lessonEntry.data;
const song = getSong(lesson.songSlug);
if (!song) {
  throw new Error(`Missing song metadata: ${lesson.songSlug}`);
}
const grammarMap = new Map(
  grammarEntries.map((entry) => [entry.id, entry]),
);
const lessonGrammarIds = [...new Set(lesson.sentences.flatMap((item) => item.grammarIds))];
const missingGrammarIds = lessonGrammarIds.filter((id) => !grammarMap.has(id));
if (missingGrammarIds.length) {
  throw new Error(`Missing grammar content: ${missingGrammarIds.join(', ')}`);
}

const kanjiMap = new Map(
  kanjiEntries.map((entry) => [entry.data.character, entry]),
);
const lessonKanji = lesson.sentences.flatMap((item) => item.kanjiIds);
const missingKanjiIds = [...new Set(lessonKanji)].filter((id) => !kanjiMap.has(id));
if (missingKanjiIds.length) {
  throw new Error(`Missing kanji content: ${missingKanjiIds.join(', ')}`);
}
const orderedKanji = [...new Set(lessonKanji)].map((character) => kanjiMap.get(character)!);
---

<BaseLayout title={lesson.title} description={lesson.description}>
  <section class="lesson-hero">
    <div class="shell">
      <a class="breadcrumb" href={withBase(`/songs/${song.slug}/`)}>{song.title}</a>
      <div class="lesson-title-row">
        <div>
          <p class="eyebrow">LESSON {String(lesson.lessonNumber).padStart(2, '0')}</p>
          <h1>{lesson.title}</h1>
          <p>{lesson.subtitle}</p>
        </div>
        <div class="lesson-time">
          <strong>{lesson.estimatedMinutes}</strong>
          <span>분 코스</span>
        </div>
      </div>
    </div>
  </section>

  <div class="shell lesson-layout">
    <div class="lesson-main">
      <ReadingControls client:load />

      <section class="lesson-section" aria-label="가사 읽기">
        <div class="sentence-list">
          {
            lesson.sentences.map((sentence, index) => (
              <SentenceCard
                sentence={sentence}
                number={index + 1}
                grammar={sentence.grammarIds.map((id) => grammarMap.get(id)!)}
                kanji={sentence.kanjiIds.map((character) => kanjiMap.get(character)!)}
              />
            ))
          }
        </div>
      </section>

      <section class="lesson-section" aria-labelledby="vocabulary-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">주요 어휘</p>
            <h2 id="vocabulary-title">문장 안에서 단어 익히기</h2>
          </div>
          <p>별표를 눌러 이 기기에 즐겨찾기를 남길 수 있어요.</p>
        </div>
        <VocabularySection items={lesson.vocabulary} />
      </section>

      <section class="split-study-section">
        <div>
          <div class="section-heading compact">
            <div>
              <p class="eyebrow">플래시카드</p>
              <h2>뜻이 바로 떠오르나요?</h2>
            </div>
          </div>
          <Flashcards items={lesson.vocabulary} client:visible />
        </div>
        <div>
          <div class="section-heading compact">
            <div>
              <p class="eyebrow">한자 노트</p>
              <h2>이번 단원의 {orderedKanji.length}자</h2>
            </div>
          </div>
          <div class="kanji-grid">
            {
              orderedKanji.map((entry, index) => (
                <KanjiPopover
                  entry={entry}
                  popoverId={`${lessonEntry.id}-kanji-index-${index}`}
                  variant="grid"
                />
              ))
            }
          </div>
          <p class="mnemonic-notice">
            팝오버의 연상법은 학습용 기억 장치이며 실제 어원 설명이 아닙니다.
          </p>
        </div>
      </section>

      <section class="lesson-section quiz-section" aria-labelledby="quiz-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">마무리 퀴즈</p>
            <h2 id="quiz-title">표현을 제대로 만났는지 확인해요</h2>
          </div>
          <p>최고 점수는 이 기기에 자동 저장됩니다.</p>
        </div>
        <Quiz lessonId={lessonEntry.id} questions={lesson.quiz} client:visible />
      </section>

      <section class="lesson-section grammar-index" aria-labelledby="grammar-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">문법 색인</p>
            <h2 id="grammar-title">이 단원의 표현 한눈에 보기</h2>
          </div>
        </div>
        <div class="grammar-link-grid">
          {
            lessonGrammarIds.map((id, index) => (
              <GrammarPopover
                entry={grammarMap.get(id)!}
                popoverId={`${lessonEntry.id}-grammar-index-${index}`}
                variant="index"
                sequence={String(index + 1).padStart(2, '0')}
              />
            ))
          }
        </div>
      </section>
    </div>

    <div class="lesson-sidebar">
      <ProgressPanel
        lessonId={lessonEntry.id}
        sentenceCount={lesson.sentences.length}
        client:idle
      />
    </div>
  </div>
</BaseLayout>

<style>
  .lesson-hero {
    padding: 2.5rem 0 3rem;
    background: var(--ink);
    color: var(--white);
  }

  .lesson-hero :global(.breadcrumb) {
    color: #b9c6d0;
  }

  .lesson-hero :global(.eyebrow) {
    color: var(--yellow);
  }

  .lesson-title-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .lesson-title-row h1 {
    margin-bottom: 0.35rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2.2rem, 9vw, 4.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .lesson-title-row p {
    margin-bottom: 0;
    color: #becbd4;
  }

  .lesson-time {
    display: none;
    text-align: center;
  }

  .lesson-time strong,
  .lesson-time span {
    display: block;
  }

  .lesson-time strong {
    color: var(--yellow);
    font-family: Georgia, serif;
    font-size: 3.5rem;
    line-height: 1;
  }

  .lesson-time span {
    font-size: 0.75rem;
  }

  .lesson-layout {
    padding: 1.5rem 0 5rem;
  }

  .lesson-main {
    min-width: 0;
  }

  .lesson-section {
    margin-bottom: 4.7rem;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    margin-bottom: 0.7rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(1.7rem, 6vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .section-heading > p {
    max-width: 28rem;
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  .section-heading.compact {
    margin-bottom: 1rem;
  }

  .section-heading.compact h2 {
    font-size: 1.6rem;
  }

  .sentence-list {
    display: grid;
    gap: 1rem;
  }

  .split-study-section {
    display: grid;
    gap: 3.5rem;
    margin-bottom: 4.7rem;
  }

  .kanji-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .mnemonic-notice {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .quiz-section {
    padding: 1.3rem;
    border-radius: calc(var(--radius) + 0.25rem);
    background: #efe9dd;
  }

  .grammar-link-grid {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 42rem) {
    .lesson-time {
      display: block;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
    }

    .split-study-section {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .quiz-section {
      padding: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .lesson-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3rem;
      padding-top: 2rem;
    }

    .lesson-sidebar {
      order: 2;
    }
  }
</style>
