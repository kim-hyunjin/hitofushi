---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';
import { Button } from '@/components/starwind/button';
import Eyebrow from '@/components/Eyebrow';
import PageShell from '@/components/PageShell.astro';
import LyricsReview, {
  type LyricsReviewGroup,
} from '@/components/LyricsReview';
import { getLessonsForSong } from '@/lib/content';
import { withBase } from '@/lib/paths';
import { songs, type SongDefinition } from '@/lib/songs';

export function getStaticPaths() {
  return songs.map((song) => ({
    params: { songSlug: song.slug },
    props: { song },
  }));
}

interface Props {
  song: SongDefinition;
}

const { song } = Astro.props;
const lessons = await getLessonsForSong(song.slug);

if (!lessons.length) {
  throw new Error(`${song.title} lesson content is missing`);
}

const groups: LyricsReviewGroup[] = lessons.map((lesson) => ({
  lessonNumber: lesson.data.lessonNumber,
  title: lesson.data.title,
  sentences: lesson.data.sentences,
}));
const sentenceCount = groups.reduce((total, group) => total + group.sentences.length, 0);
---

<BaseLayout
  title={`${song.title} 가사 최종 점검`}
  description={`${song.title} 가사 ${sentenceCount}문장을 한눈에 보고 이해도를 최종 점검합니다.`}
>
  <section class="overflow-hidden bg-[var(--hero)] py-12 pb-14 text-[var(--hero-foreground)]">
    <PageShell class="flex items-center justify-between gap-4">
      <div>
        <Breadcrumb class="mb-5 text-[var(--on-ink-soft)]">
          <BreadcrumbList>
            <BreadcrumbItem><BreadcrumbLink href={withBase(`/songs/${song.slug}/`)}>{song.title}</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbPage class="text-[var(--hero-foreground)]">최종 점검</BreadcrumbPage></BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        <Eyebrow tone="hero">FINAL REVIEW</Eyebrow>
        <h1 class="mb-[0.7rem] text-[length:clamp(2.5rem,10vw,4.7rem)] font-medium leading-[1.08] tracking-[-0.055em]">가사 전문과<br />최종 점검</h1>
        <p class="mb-0 text-[var(--on-ink-soft)]">{song.artist} · {sentenceCount}문장으로 한 곡을 마무리해요.</p>
      </div>
      <div class="hidden aspect-square w-44 shrink-0 place-content-center rounded-full border border-[rgb(255_255_255_/_22%)] bg-[rgb(255_255_255_/_6%)] text-center min-[42rem]:grid" aria-hidden="true">
        <span class="block text-[4rem] leading-none text-[var(--yellow)]">完</span>
        <small class="mt-2 block text-[0.65rem] font-[850] tracking-[0.18em] text-[var(--on-ink-soft)]">FINAL</small>
      </div>
    </PageShell>
  </section>

  <PageShell class="pb-20 pt-14">
    <div class="mb-8 max-w-168">
      <Eyebrow>한 곡 다시 읽기</Eyebrow>
      <h2 class="mb-[0.7rem] text-[length:clamp(1.8rem,6vw,2.8rem)] font-semibold leading-[1.2] tracking-[-0.04em]">배운 가사를 처음부터 끝까지 연결해 보세요</h2>
      <p class="text-muted-foreground">
        전체 가사에서는 앞서 익힌 문장을 단원별로 빠르게 훑을 수 있습니다.
        준비되면 문장별 자가점검에서 해석을 먼저 떠올려 보세요.
      </p>
    </div>

    <LyricsReview
      songSlug={song.slug}
      songTitle={song.title}
      groups={groups}
      client:load
    />

    <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-8 text-[0.85rem] font-extrabold" aria-label="노래 학습 이동">
      <a href={withBase(`/songs/${song.slug}/`)}>← 단원 목록으로</a>
      <Button href={withBase('/songs/')}>다른 노래 고르기 →</Button>
    </nav>
  </PageShell>
</BaseLayout>
