---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '../../../components/starwind/breadcrumb';
import { Button } from '../../../components/starwind/button';
import Eyebrow from '../../../components/Eyebrow';
import PageShell from '../../../components/PageShell.astro';
import LyricsReview, {
  type LyricsReviewGroup,
} from '../../../components/LyricsReview';
import { getLessonsForSong } from '../../../lib/content';
import { withBase } from '../../../lib/paths';
import { songs, type SongDefinition } from '../../../lib/songs';

export function getStaticPaths() {
  return songs.map((song) => ({
    params: { songSlug: song.slug },
    props: { song },
  }));
}

interface Props {
  song: SongDefinition;
}

const { song } = Astro.props;
const lessons = await getLessonsForSong(song.slug);

if (!lessons.length) {
  throw new Error(`${song.title} lesson content is missing`);
}

const groups: LyricsReviewGroup[] = lessons.map((lesson) => ({
  lessonNumber: lesson.data.lessonNumber,
  title: lesson.data.title,
  sentences: lesson.data.sentences,
}));
const sentenceCount = groups.reduce((total, group) => total + group.sentences.length, 0);
---

<BaseLayout
  title={`${song.title} 가사 최종 점검`}
  description={`${song.title} 가사 ${sentenceCount}문장을 한눈에 보고 이해도를 최종 점검합니다.`}
>
  <section class="review-hero">
    <PageShell class="review-hero-inner">
      <div>
        <Breadcrumb class="mb-5 text-[var(--on-ink-soft)]">
          <BreadcrumbList>
            <BreadcrumbItem><BreadcrumbLink href={withBase(`/songs/${song.slug}/`)}>{song.title}</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbPage class="text-[var(--hero-foreground)]">최종 점검</BreadcrumbPage></BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        <Eyebrow tone="hero">FINAL REVIEW</Eyebrow>
        <h1>가사 전문과<br />최종 점검</h1>
        <p>{song.artist} · {sentenceCount}문장으로 한 곡을 마무리해요.</p>
      </div>
      <div class="final-mark" aria-hidden="true">
        <span>完</span>
        <small>FINAL</small>
      </div>
    </PageShell>
  </section>

  <PageShell class="review-page">
    <div class="review-intro">
      <Eyebrow>한 곡 다시 읽기</Eyebrow>
      <h2>배운 가사를 처음부터 끝까지 연결해 보세요</h2>
      <p>
        전체 가사에서는 앞서 익힌 문장을 단원별로 빠르게 훑을 수 있습니다.
        준비되면 문장별 자가점검에서 해석을 먼저 떠올려 보세요.
      </p>
    </div>

    <LyricsReview
      songSlug={song.slug}
      songTitle={song.title}
      groups={groups}
      client:load
    />

    <nav class="review-footer" aria-label="노래 학습 이동">
      <a href={withBase(`/songs/${song.slug}/`)}>← 단원 목록으로</a>
      <Button href={withBase('/songs/')}>다른 노래 고르기 →</Button>
    </nav>
  </PageShell>
</BaseLayout>

<style>
  .review-hero {
    overflow: hidden;
    padding: 3rem 0 3.5rem;
    background: var(--hero);
    color: var(--hero-foreground);
  }

  .review-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .review-hero h1 {
    margin-bottom: 0.7rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2.5rem, 10vw, 4.7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .review-hero p:last-child {
    margin-bottom: 0;
    color: var(--on-ink-soft);
  }

  .final-mark {
    display: none;
    width: 11rem;
    flex: 0 0 auto;
    aspect-ratio: 1;
    place-content: center;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    background: rgb(255 255 255 / 6%);
    text-align: center;
  }

  .final-mark span,
  .final-mark small {
    display: block;
  }

  .final-mark span {
    color: var(--yellow);
    font-family: Georgia, "Noto Serif JP", serif;
    font-size: 4rem;
    line-height: 1;
  }

  .final-mark small {
    margin-top: 0.5rem;
    color: var(--on-ink-soft);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.18em;
  }

  .review-page {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .review-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .review-intro h2 {
    margin-bottom: 0.7rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .review-intro > p:last-child {
    color: var(--ink-soft);
  }

  .review-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 800;
  }

  @media (min-width: 42rem) {
    .final-mark {
      display: grid;
    }
  }
</style>
