---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/starwind/badge';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';
import { Button } from '@/components/starwind/button';
import { Card } from '@/components/starwind/card';
import Eyebrow from '@/components/Eyebrow';
import PageShell from '@/components/PageShell.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/paths';
import { songs, type SongDefinition } from '@/lib/songs';
import { getLessonsForSong } from '@/lib/content';

export function getStaticPaths() {
  return songs.map((song) => ({
    params: { songSlug: song.slug },
    props: { song },
  }));
}

interface Props {
  song: SongDefinition;
}

const { song } = Astro.props;
const grammarEntries = await getCollection('grammar');
const songLessons = await getLessonsForSong(song.slug);
const grammarMap = new Map(
  grammarEntries.map((entry) => [entry.id, entry.data.title]),
);

if (!songLessons.length) {
  throw new Error(`${song.title} lesson content is missing`);
}
---

<BaseLayout
  title={song.title}
  description={`${song.title} 가사로 배우는 HitoFushi 일본어 학습 과정`}
>
  <section class="overflow-hidden bg-[var(--hero)] py-14 text-[var(--hero-foreground)]">
    <PageShell class="flex items-center justify-between gap-4">
      <div>
        <Breadcrumb class="mb-5 text-[var(--on-ink-soft)]">
          <BreadcrumbList>
            <BreadcrumbItem><BreadcrumbLink href={withBase('/')}>홈</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbPage class="text-[var(--hero-foreground)]">{song.title}</BreadcrumbPage></BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        <Eyebrow tone="hero">SONG {String(song.sequence).padStart(2, '0')}</Eyebrow>
        <h1 class="mb-[0.6rem] text-[length:clamp(3.6rem,16vw,7rem)] font-medium italic leading-[0.9] tracking-[-0.06em] [font-family:Georgia,serif]">{song.title}</h1>
        <p class="mb-0 text-[var(--on-ink-soft)]">{song.artist} · {song.kicker}</p>
      </div>
      <div
        class="hidden aspect-square w-56 place-items-center rounded-full bg-[radial-gradient(circle,var(--paper)_0_9%,transparent_10%_18%,rgb(255_255_255_/_16%)_19%_20%,transparent_21%),repeating-radial-gradient(circle,#203e59_0_4px,#19344d_5px_8px)] shadow-[0_2rem_5rem_rgb(0_0_0_/_25%)] min-[42rem]:grid"
        aria-hidden="true"
      >
        <span class="grid aspect-square w-[2.6rem] place-items-center rounded-full bg-accent">あ</span>
      </div>
    </PageShell>
  </section>

  <PageShell as="section" class="py-16 pb-20">
    <div class="mb-8 max-w-152">
      <Eyebrow>학습 안내</Eyebrow>
      <h2 class="mb-[0.7rem] text-[length:clamp(1.7rem,6vw,2.7rem)] font-semibold leading-[1.2] tracking-[-0.04em] [font-family:Georgia,'Noto_Serif_KR',serif]">
        {songLessons.length + 1}개 단원으로 읽는 한 곡
      </h2>
      <p class="text-muted-foreground">{song.description} 핵심 문법과 어휘, 한자를 익힌 뒤 가사 전체를 최종 점검합니다.</p>
    </div>

    <div class="grid gap-4">
      {
        songLessons.map((lesson) => {
          const grammarIds = [
            ...new Set(lesson.data.sentences.flatMap((sentence) => sentence.grammarIds)),
          ].slice(0, 4);

          return (
            <Card class="grid gap-[1.2rem] rounded-lg border border-border bg-card p-6 shadow-[var(--shadow)] min-[42rem]:grid-cols-[4rem_1fr_auto] min-[42rem]:items-center min-[42rem]:p-8" role="article">
              <div class="text-[2rem] text-accent [font-family:Georgia,serif]">
                {String(lesson.data.lessonNumber).padStart(2, '0')}
              </div>
              <div>
                <span class="text-[0.8rem] font-[750] text-muted-foreground">
                  약 {lesson.data.estimatedMinutes}분 · {lesson.data.sentences.length}문장
                </span>
                <h3 class="my-[0.3rem] text-[1.4rem]">{lesson.data.title}</h3>
                <p class="text-muted-foreground">{lesson.data.description}</p>
                <div class="flex flex-wrap gap-[0.4rem]">
                  {grammarIds.map((id) => <Badge variant="secondary">{grammarMap.get(id) ?? id}</Badge>)}
                </div>
              </div>
              <Button
                href={withBase(`/songs/${song.slug}/lessons/${lesson.data.lessonNumber}/`)}
              >
                단원 시작 <span aria-hidden="true">→</span>
              </Button>
            </Card>
          );
        })
      }
      <Card class="grid gap-[1.2rem] rounded-lg border border-warning bg-[linear-gradient(135deg,color-mix(in_srgb,var(--warning)_18%,var(--card)),var(--card))] p-6 shadow-[var(--shadow)] min-[42rem]:grid-cols-[4rem_1fr_auto] min-[42rem]:items-center min-[42rem]:p-8" role="article">
        <div class="text-[2rem] text-accent-foreground [font-family:Georgia,serif]">完</div>
        <div>
          <span class="text-[0.8rem] font-[750] text-muted-foreground">
            최종 단원 · {songLessons.reduce((total, lesson) => total + lesson.data.sentences.length, 0)}문장
          </span>
          <h3 class="my-[0.3rem] text-[1.4rem]">가사 전문과 최종 점검</h3>
          <p class="text-muted-foreground">가사를 처음부터 끝까지 한눈에 읽고, 해석을 떠올리며 이해한 문장을 직접 점검합니다.</p>
          <div class="flex flex-wrap gap-[0.4rem]">
            <Badge variant="warning">가사 전문</Badge>
            <Badge variant="warning">이해도 자가점검</Badge>
            <Badge variant="warning">자동 저장</Badge>
          </div>
        </div>
        <Button href={withBase(`/songs/${song.slug}/review/`)}>
          최종 점검 <span aria-hidden="true">→</span>
        </Button>
      </Card>
    </div>
  </PageShell>
</BaseLayout>
