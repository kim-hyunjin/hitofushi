---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/paths';
import { songs, type SongDefinition } from '../../../lib/songs';
import { getLessonsForSong } from '../../../lib/content';

export function getStaticPaths() {
  return songs.map((song) => ({
    params: { songSlug: song.slug },
    props: { song },
  }));
}

interface Props {
  song: SongDefinition;
}

const { song } = Astro.props;
const grammarEntries = await getCollection('grammar');
const songLessons = await getLessonsForSong(song.slug);
const grammarMap = new Map(
  grammarEntries.map((entry) => [entry.id, entry.data.title]),
);

if (!songLessons.length) {
  throw new Error(`${song.title} lesson content is missing`);
}
---

<BaseLayout
  title={song.title}
  description={`${song.title} 가사로 배우는 HitoFushi 일본어 학습 과정`}
>
  <section class="song-hero">
    <div class="shell song-hero-inner">
      <div>
        <a class="breadcrumb" href={withBase('/')}>홈</a>
        <p class="eyebrow">SONG {String(song.sequence).padStart(2, '0')}</p>
        <h1>{song.title}</h1>
        <p class="song-kicker">{song.artist} · {song.kicker}</p>
      </div>
      <div class="song-disc" aria-hidden="true">
        <span>あ</span>
      </div>
    </div>
  </section>

  <section class="shell song-overview">
    <div class="section-intro">
      <p class="eyebrow">학습 안내</p>
      <h2>{songLessons.length + 1}개 단원으로 읽는 한 곡</h2>
      <p>{song.description} 핵심 문법과 어휘, 한자를 익힌 뒤 가사 전체를 최종 점검합니다.</p>
    </div>

    <div class="lesson-list">
      {
        songLessons.map((lesson) => {
          const grammarIds = [
            ...new Set(lesson.data.sentences.flatMap((sentence) => sentence.grammarIds)),
          ].slice(0, 4);

          return (
            <article class="lesson-list-card">
              <div class="lesson-index">
                {String(lesson.data.lessonNumber).padStart(2, '0')}
              </div>
              <div class="lesson-summary">
                <span>
                  약 {lesson.data.estimatedMinutes}분 · {lesson.data.sentences.length}문장
                </span>
                <h3>{lesson.data.title}</h3>
                <p>{lesson.data.description}</p>
                <div class="lesson-tags">
                  {grammarIds.map((id) => <span>{grammarMap.get(id) ?? id}</span>)}
                </div>
              </div>
              <a
                class="primary-link"
                href={withBase(`/songs/${song.slug}/lessons/${lesson.data.lessonNumber}/`)}
              >
                단원 시작 <span aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
      <article class="lesson-list-card final-card">
        <div class="lesson-index">完</div>
        <div class="lesson-summary">
          <span>
            최종 단원 · {songLessons.reduce((total, lesson) => total + lesson.data.sentences.length, 0)}문장
          </span>
          <h3>가사 전문과 최종 점검</h3>
          <p>가사를 처음부터 끝까지 한눈에 읽고, 해석을 떠올리며 이해한 문장을 직접 점검합니다.</p>
          <div class="lesson-tags">
            <span>가사 전문</span>
            <span>이해도 자가점검</span>
            <span>자동 저장</span>
          </div>
        </div>
        <a class="primary-link" href={withBase(`/songs/${song.slug}/review/`)}>
          최종 점검 <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .song-hero {
    overflow: hidden;
    padding: 3.5rem 0;
    background: var(--ink);
    color: var(--white);
  }

  .song-hero :global(.breadcrumb) {
    color: #b9c6d0;
  }

  .song-hero :global(.eyebrow) {
    color: var(--yellow);
  }

  .song-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .song-hero h1 {
    margin-bottom: 0.6rem;
    font-family: Georgia, serif;
    font-size: clamp(3.6rem, 16vw, 7rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .song-kicker {
    margin-bottom: 0;
    color: #c7d0d8;
  }

  .song-disc {
    display: none;
    width: 14rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        var(--paper) 0 9%,
        transparent 10% 18%,
        rgb(255 255 255 / 16%) 19% 20%,
        transparent 21%
      ),
      repeating-radial-gradient(circle, #203e59 0 4px, #19344d 5px 8px);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 25%);
  }

  .song-disc span {
    display: grid;
    width: 2.6rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
  }

  .song-overview {
    padding: 4rem 0 5rem;
  }

  .lesson-list {
    display: grid;
    gap: 1rem;
  }

  .lesson-list-card {
    display: grid;
    gap: 1.2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .lesson-index {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 2rem;
  }

  .final-card {
    border-color: #d7b955;
    background: linear-gradient(135deg, #fffaf0, var(--surface));
  }

  .final-card .lesson-index {
    color: #9b7810;
  }

  .lesson-summary > span {
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 750;
  }

  .lesson-summary h3 {
    margin: 0.3rem 0;
    font-size: 1.4rem;
  }

  .lesson-summary p {
    color: var(--ink-soft);
  }

  .lesson-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lesson-tags span {
    padding: 0.3rem 0.6rem;
    border-radius: 99rem;
    background: var(--accent-pale);
    color: #7c2d20;
    font-size: 0.75rem;
    font-weight: 750;
  }

  @media (min-width: 42rem) {
    .song-disc {
      display: grid;
    }

    .lesson-list-card {
      grid-template-columns: 4rem 1fr auto;
      align-items: center;
      padding: 2rem;
    }
  }
</style>
