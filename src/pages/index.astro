---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow';
import HomeLearningCta from '../components/HomeLearningCta';
import PageShell from '../components/PageShell.astro';
import { Button } from '../components/starwind/button';
import { Card } from '../components/starwind/card';
import { getOrderedLessons } from '../lib/content';
import { withBase } from '../lib/paths';
import { songs } from '../lib/songs';

const orderedLessons = await getOrderedLessons();
const homeLessonSummaries = orderedLessons.map((entry) => ({
  id: entry.id,
  href: withBase(
    `/songs/${entry.data.songSlug}/lessons/${entry.data.lessonNumber}/`,
  ),
  sentenceIds: entry.data.sentences.map((sentence) => sentence.id),
  vocabularyIds: entry.data.vocabulary.map((item) => item.id),
}));
const courseCards = songs.slice(0, 5).map((song) => {
  const songLessons = orderedLessons.filter(
    (entry) => entry.data.songSlug === song.slug,
  );

  return {
    ...song,
    sentenceCount: songLessons.reduce(
      (total, entry) => total + entry.data.sentences.length,
      0,
    ),
    vocabularyCount: songLessons.reduce(
      (total, entry) => total + entry.data.vocabulary.length,
      0,
    ),
    kanjiCount: new Set(
      songLessons.flatMap((entry) =>
        entry.data.sentences.flatMap((sentence) => sentence.kanjiIds),
      ),
    ).size,
  };
});
---

<BaseLayout
  title="HitoFushi"
  description="노래 가사를 한 소절씩 읽으며 일본어 문법, 어휘, 한자를 익히는 학습 사이트"
>
  <section class="relative overflow-hidden py-16 pb-[4.5rem] after:absolute after:-bottom-32 after:-right-8 after:-z-10 after:text-[22rem] after:leading-none after:text-[rgb(var(--ink-rgb)_/_3%)] after:content-['歌'] lg:py-24 lg:pb-28">
    <PageShell class="grid gap-[2.2rem] min-[42rem]:grid-cols-1 min-[42rem]:items-center">
      <div>
        <Eyebrow>노래 한 소절이 오늘의 교재</Eyebrow>
        <h1 class="mb-[1.4rem] text-[length:clamp(2.7rem,10vw,5.7rem)] font-medium leading-[1.08] tracking-[-0.065em] [&_em]:not-italic [&_em]:text-accent">
          외우기 전에,<br />
          <em>마음으로 읽는 일본어</em>
        </h1>
        <p class="mb-[1.8rem] max-w-144 text-base text-muted-foreground">
          좋아하는 가사를 원문부터 천천히 읽어요. 한 소절에 담긴 문법과
          한자를 문장 안에서 익히며 노래의 마음에 가까워집니다.
        </p>
        <div class="flex flex-wrap items-center gap-5">
          <HomeLearningCta lessons={homeLessonSummaries} client:load />
        </div>
      </div>
      
    </PageShell>
  </section>

  <PageShell as="section" class="mb-20 grid gap-5" aria-label="노래별 학습 과정">
    {
      courseCards.map((song) => (
        <Card
          class="grid gap-6 rounded-lg border-[color-mix(in_srgb,var(--primary)_28%,var(--border))] bg-[color-mix(in_srgb,var(--card)_82%,var(--secondary))] p-8 [&_h2]:mb-[0.4rem] [&_h2]:text-[2.3rem] [&_p]:mb-0 min-[42rem]:grid-cols-[1.2fr_1fr] min-[42rem]:items-center min-[42rem]:p-10 min-[42rem]:[&_[data-slot=button]]:justify-self-start"
          role="article"
        >
          <div>
            <Eyebrow>{song.sequence}번째 곡</Eyebrow>
            <h2>{song.title}</h2>
            <p>{song.description}</p>
          </div>
          <div class="grid grid-cols-2 gap-[0.7rem] min-[42rem]:grid-cols-3 [&_span]:rounded-xl [&_span]:bg-[color-mix(in_srgb,var(--background)_52%,transparent)] [&_span]:p-[0.8rem] [&_span]:text-[0.8rem] [&_span]:text-muted-foreground [&_strong]:block [&_strong]:text-2xl [&_strong]:text-foreground">
            <span><strong>{song.sentenceCount}</strong> 문장</span>
            <span><strong>{song.vocabularyCount}</strong> 단어</span>
            <span><strong>{song.kanjiCount}</strong> 한자</span>
          </div>
          <Button href={withBase(`/songs/${song.slug}/`)}>
            학습 내용 살펴보기
          </Button>
        </Card>
      ))
    }
    <div class="flex justify-center">
      <Button variant="ghost" href={withBase('/songs/')}>전체 노래 보기</Button>
    </div>
  </PageShell>
</BaseLayout>
