---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLearningCta from '../components/HomeLearningCta';
import { getOrderedLessons } from '../lib/content';
import { withBase } from '../lib/paths';

const orderedLessons = await getOrderedLessons();
const vintageLessons = orderedLessons
  .filter((entry) => entry.data.songSlug === 'vintage')
  .sort((a, b) => a.data.lessonNumber - b.data.lessonNumber);
const homeLessonSummaries = orderedLessons.map((entry) => ({
  id: entry.id,
  href: withBase(
    `/songs/${entry.data.songSlug}/lessons/${entry.data.lessonNumber}/`,
  ),
  sentenceIds: entry.data.sentences.map((sentence) => sentence.id),
  vocabularyIds: entry.data.vocabulary.map((item) => item.id),
}));
const sentenceCount = vintageLessons.reduce(
  (total, entry) => total + entry.data.sentences.length,
  0,
);
const vocabularyCount = vintageLessons.reduce(
  (total, entry) => total + entry.data.vocabulary.length,
  0,
);
const kanjiCount = new Set(
  vintageLessons.flatMap((entry) =>
    entry.data.sentences.flatMap((sentence) => sentence.kanjiIds),
  ),
).size;
const estimatedMinutes = vintageLessons.reduce(
  (total, entry) => total + entry.data.estimatedMinutes,
  0,
);
---

<BaseLayout
  title="HitoFushi"
  description="노래 가사를 한 소절씩 읽으며 일본어 문법, 어휘, 한자를 익히는 학습 사이트"
>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">노래 한 소절이 오늘의 교재</p>
        <h1>
          외우기 전에,<br />
          <em>마음으로 읽는 일본어</em>
        </h1>
        <p class="hero-description">
          좋아하는 가사를 원문부터 천천히 읽어요. 한 소절에 담긴 문법과
          한자를 문장 안에서 익히며 노래의 마음에 가까워집니다.
        </p>
        <div class="hero-actions">
          <HomeLearningCta lessons={homeLessonSummaries} client:load />
          <a class="text-link" href={withBase('/songs/')}>노래 목록 보기</a>
        </div>
      </div>
      <div class="hero-sample" aria-label="학습 예시">
        <span class="sample-label">TODAY'S LINE · 01</span>
        <p lang="ja">
          <ruby>口喧嘩<rt>くちげんか</rt></ruby>なんか<br />
          したくもないから
        </p>
        <div class="sample-divider"></div>
        <small>말다툼 같은 건 하고 싶지 않으니까</small>
      </div>
    </div>
  </section>

  <section class="shell home-section">
    <div class="section-intro">
      <p class="eyebrow">한 문장을 세 번 만나요</p>
      <h2>처음에는 친절하게, 나중에는 온전히</h2>
      <p>읽기 도움을 단계적으로 줄이며 일본어 원문에 가까워집니다.</p>
    </div>
    <div class="mode-preview-grid">
      <article>
        <span>01</span>
        <h3>입문 모드</h3>
        <p>원문과 뜻을 함께 보며 문장의 전체 흐름을 익힙니다.</p>
      </article>
      <article>
        <span>02</span>
        <h3>초급 모드</h3>
        <p>번역을 곁에 두고 일본어 어순과 표현에 집중합니다.</p>
      </article>
      <article>
        <span>03</span>
        <h3>읽기 모드</h3>
        <p>원문을 먼저 읽고, 어려운 한자의 읽기는 직접 확인합니다.</p>
      </article>
    </div>
  </section>

  <section class="shell current-course">
    <div>
      <p class="eyebrow">첫 번째 곡</p>
      <h2>Vintage</h2>
      <p>
        상처를 피하던 마음에서 함께한 시간과 기억을 사랑하는 마음까지,
        한 곡의 흐름을 일곱 단원으로 배워요.
      </p>
    </div>
    <div class="course-stats">
      <span><strong>{sentenceCount}</strong> 문장</span>
      <span><strong>{vocabularyCount}</strong> 단어</span>
      <span><strong>{kanjiCount}</strong> 한자</span>
      <span><strong>{estimatedMinutes}</strong> 분</span>
    </div>
    <a class="primary-link" href={withBase('/songs/vintage/')}>학습 내용 살펴보기</a>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 0 4.5rem;
  }

  .home-hero::after {
    content: "歌";
    position: absolute;
    z-index: -1;
    right: -2rem;
    bottom: -8rem;
    color: rgb(23 50 77 / 3%);
    font-family: Georgia, serif;
    font-size: 22rem;
    line-height: 1;
  }

  .hero-grid {
    display: grid;
    gap: 2.2rem;
  }

  .hero-copy h1 {
    max-width: 12ch;
    margin-bottom: 1.4rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2.7rem, 10vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  .hero-copy h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero-description {
    max-width: 36rem;
    margin-bottom: 1.8rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .text-link {
    padding: 0.5rem 0;
    border-bottom: 1px solid currentColor;
    font-size: 0.9rem;
    font-weight: 750;
  }

  .hero-sample {
    position: relative;
    align-self: end;
    padding: 2rem 1.5rem 1.6rem;
    border: 1px solid rgb(23 50 77 / 12%);
    border-radius: 50% 50% 1.5rem 1.5rem;
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow);
  }

  .hero-sample::before {
    content: "";
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 0.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
  }

  .sample-label {
    color: var(--mint);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero-sample > p {
    margin: 1.6rem 0;
    font-family: "Noto Serif JP", "Yu Mincho", serif;
    font-size: clamp(1.6rem, 7vw, 2.6rem);
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .sample-divider {
    width: 3.5rem;
    height: 2px;
    margin-bottom: 1rem;
    background: var(--accent);
  }

  .hero-sample small {
    color: #dce5e8;
  }

  .home-section,
  .current-course {
    margin-bottom: 5rem;
  }

  .mode-preview-grid {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .mode-preview-grid article {
    padding: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .mode-preview-grid article:last-child {
    border: 0;
  }

  .mode-preview-grid article > span {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 0.85rem;
  }

  .mode-preview-grid h3 {
    margin: 0.7rem 0 0.45rem;
    font-size: 1.1rem;
  }

  .mode-preview-grid p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .current-course {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--mint);
  }

  .current-course h2 {
    margin-bottom: 0.4rem;
    font-family: Georgia, serif;
    font-size: 2.3rem;
  }

  .current-course p {
    margin-bottom: 0;
  }

  .course-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
  }

  .course-stats span {
    padding: 0.8rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 38%);
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .course-stats strong {
    display: block;
    color: var(--ink);
    font-family: Georgia, serif;
    font-size: 1.5rem;
  }

  @media (min-width: 42rem) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .hero-sample {
      padding: 2.7rem 2.2rem 2rem;
    }

    .mode-preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .mode-preview-grid article {
      min-height: 13rem;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .current-course {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: 2.5rem;
    }

    .current-course :global(.primary-link) {
      justify-self: start;
    }

    .course-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .home-hero {
      padding: 6rem 0 7rem;
    }
  }
</style>
