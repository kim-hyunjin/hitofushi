---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLearningCta from '../components/HomeLearningCta';
import { getOrderedLessons } from '../lib/content';
import { withBase } from '../lib/paths';
import { songs } from '../lib/songs';

const orderedLessons = await getOrderedLessons();
const homeLessonSummaries = orderedLessons.map((entry) => ({
  id: entry.id,
  href: withBase(
    `/songs/${entry.data.songSlug}/lessons/${entry.data.lessonNumber}/`,
  ),
  sentenceIds: entry.data.sentences.map((sentence) => sentence.id),
  vocabularyIds: entry.data.vocabulary.map((item) => item.id),
}));
const courseCards = songs.slice(0, 5).map((song) => {
  const songLessons = orderedLessons.filter(
    (entry) => entry.data.songSlug === song.slug,
  );

  return {
    ...song,
    sentenceCount: songLessons.reduce(
      (total, entry) => total + entry.data.sentences.length,
      0,
    ),
    vocabularyCount: songLessons.reduce(
      (total, entry) => total + entry.data.vocabulary.length,
      0,
    ),
    kanjiCount: new Set(
      songLessons.flatMap((entry) =>
        entry.data.sentences.flatMap((sentence) => sentence.kanjiIds),
      ),
    ).size,
    estimatedMinutes: songLessons.reduce(
      (total, entry) => total + entry.data.estimatedMinutes,
      0,
    ),
  };
});
---

<BaseLayout
  title="HitoFushi"
  description="노래 가사를 한 소절씩 읽으며 일본어 문법, 어휘, 한자를 익히는 학습 사이트"
>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">노래 한 소절이 오늘의 교재</p>
        <h1>
          외우기 전에,<br />
          <em>마음으로 읽는 일본어</em>
        </h1>
        <p class="hero-description">
          좋아하는 가사를 원문부터 천천히 읽어요. 한 소절에 담긴 문법과
          한자를 문장 안에서 익히며 노래의 마음에 가까워집니다.
        </p>
        <div class="hero-actions">
          <HomeLearningCta lessons={homeLessonSummaries} client:load />
          <a class="text-link" href={withBase('/songs/')}>노래 목록 보기</a>
        </div>
      </div>
      
    </div>
  </section>

  <section class="shell current-courses" aria-label="노래별 학습 과정">
    {
      courseCards.map((song) => (
        <article class="current-course">
          <div>
            <p class="eyebrow">{song.sequence}번째 곡</p>
            <h2>{song.title}</h2>
            <p>{song.description}</p>
          </div>
          <div class="course-stats">
            <span><strong>{song.sentenceCount}</strong> 문장</span>
            <span><strong>{song.vocabularyCount}</strong> 단어</span>
            <span><strong>{song.kanjiCount}</strong> 한자</span>
            <span><strong>{song.estimatedMinutes}</strong> 분</span>
          </div>
          <a class="primary-link" href={withBase(`/songs/${song.slug}/`)}>
            학습 내용 살펴보기
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 0 4.5rem;
  }

  .home-hero::after {
    content: "歌";
    position: absolute;
    z-index: -1;
    right: -2rem;
    bottom: -8rem;
    color: rgb(var(--ink-rgb) / 3%);
    font-family: Georgia, serif;
    font-size: 22rem;
    line-height: 1;
  }

  .hero-grid {
    display: grid;
    gap: 2.2rem;
  }

  .hero-copy h1 {
    margin-bottom: 1.4rem;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2.7rem, 10vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  .hero-copy h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero-description {
    max-width: 36rem;
    margin-bottom: 1.8rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .text-link {
    padding: 0.5rem 0;
    border-bottom: 1px solid currentColor;
    font-size: 0.9rem;
    font-weight: 750;
  }

  .sample-label {
    color: var(--mint);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }  

  .sample-divider {
    width: 3.5rem;
    height: 2px;
    margin-bottom: 1rem;
    background: var(--accent);
  }

  .current-courses {
    margin-bottom: 5rem;
  }

  .current-courses {
    display: grid;
    gap: 1.25rem;
  }

  .current-course {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--mint);
  }

  .current-course h2 {
    margin-bottom: 0.4rem;
    font-family: Georgia, serif;
    font-size: 2.3rem;
  }

  .current-course p {
    margin-bottom: 0;
  }

  .course-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
  }

  .course-stats span {
    padding: 0.8rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 38%);
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .course-stats strong {
    display: block;
    color: var(--ink);
    font-family: Georgia, serif;
    font-size: 1.5rem;
  }

  @media (min-width: 42rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: center;
    }

    .hero-sample {
      padding: 2.7rem 2.2rem 2rem;
    }

    .current-course {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: 2.5rem;
    }

    .current-course :global(.primary-link) {
      justify-self: start;
    }

    .course-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .home-hero {
      padding: 6rem 0 7rem;
    }
  }
</style>
