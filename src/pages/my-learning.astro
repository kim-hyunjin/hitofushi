---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow';
import LearningDashboard, {
  type LearningLessonSummary,
} from '../components/LearningDashboard';
import ReadingControls from '../components/ReadingControls';
import PageShell from '../components/PageShell.astro';
import { getOrderedLessons } from '../lib/content';
import { withBase } from '../lib/paths';
import { getSong } from '../lib/songs';

const lessons = await getOrderedLessons();

const lessonSummaries: LearningLessonSummary[] = lessons.map((entry) => {
  const href = withBase(
    `/songs/${entry.data.songSlug}/lessons/${entry.data.lessonNumber}/`,
  );

  return {
    id: entry.id,
    songTitle: getSong(entry.data.songSlug)?.title ?? entry.data.songSlug,
    lessonNumber: entry.data.lessonNumber,
    title: entry.data.title,
    href,
    sentenceIds: entry.data.sentences.map((sentence) => sentence.id),
    vocabulary: entry.data.vocabulary.map((item) => ({
      id: item.id,
      term: item.term,
      reading: item.reading,
      meaning: item.meaning,
      lessonTitle: entry.data.title,
      href,
    })),
  };
});
---

<BaseLayout
  title="내 학습"
  description="이 브라우저에 저장된 일본어 문장 진도, 퀴즈 점수와 즐겨찾기 어휘"
>
  <section class="py-14 pb-16">
    <PageShell>
      <Eyebrow>MY LEARNING</Eyebrow>
      <h1 class="mb-[0.8rem] text-[length:clamp(3rem,12vw,6rem)] font-medium leading-none tracking-[-0.06em] [font-family:Georgia,'Noto_Serif_KR',serif]">내 학습</h1>
      <p class="mb-0 max-w-152 text-muted-foreground">
        익힌 문장과 퀴즈 점수, 다시 보고 싶은 어휘를 한곳에서 확인하세요.
        기록은 현재 기기의 브라우저에만 저장됩니다.
      </p>
    </PageShell>
  </section>

  <PageShell class="pb-20">
    <ReadingControls client:load />
    <LearningDashboard lessons={lessonSummaries} client:load />
  </PageShell>
</BaseLayout>
