---
import { ThemeInitScript } from '@starwind-ui/astro/theme';
import Menu from '@tabler/icons/outline/menu-2.svg';
import Home from '@tabler/icons/outline/home.svg';
import Library from '@tabler/icons/outline/books.svg';
import Chart from '@tabler/icons/outline/chart-dots-3.svg';
import '@/styles/starwind.css';
import '../styles/global.css';
import PageShell from '../components/PageShell.astro';
import { ThemeToggle } from '../components/starwind/theme-toggle';
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from '../components/starwind/navigation-menu';
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '../components/starwind/sheet';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === 'HitoFushi' ? title : `${title} | HitoFushi`;
const pathname = Astro.url.pathname;
const songsActive = pathname.includes('/songs/');
const learningActive = pathname.includes('/my-learning/');
---

<!doctype html>
<html lang="ko" data-reading-mode="beginner" data-show-translations="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fefae0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171a12" />
    <ThemeInitScript />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a
      class="fixed left-2 top-2 z-100 -translate-y-[150%] rounded-lg bg-primary px-4 py-[0.7rem] text-primary-foreground focus:translate-y-0"
      href="#main-content"
    >본문으로 건너뛰기</a>
    <header class="sticky top-0 z-40 border-b border-[color-mix(in_srgb,var(--border)_78%,transparent)] bg-[color-mix(in_srgb,var(--background)_88%,transparent)] backdrop-blur-2xl">
      <PageShell class="flex min-h-[4.6rem] items-center justify-between gap-4 max-[42rem]:min-h-17">
        <a class="inline-flex items-center gap-[0.7rem] leading-[1.15]" href={withBase('/')} aria-label="HitoFushi 홈">
          <span class="grid aspect-square w-[2.4rem] place-items-center rounded-full bg-primary text-[1.2rem] text-primary-foreground [font-family:Georgia,serif]" aria-hidden="true">あ</span>
          <span>
            <strong class="block text-[0.95rem] tracking-[-0.03em]">HitoFushi</strong>
            <small class="mt-[0.2rem] block text-[0.68rem] text-muted-foreground max-[42rem]:hidden">한 소절씩, 내 속도로</small>
          </span>
        </a>

        <div class="flex items-center gap-[0.55rem]">
          <NavigationMenu class="[&_[data-slot=navigation-menu-link]]:gap-[0.4rem] max-[42rem]:hidden" aria-label="주요 메뉴">
            <NavigationMenuList>
              <NavigationMenuItem>
                <NavigationMenuLink href={withBase('/songs/')} active={songsActive}>
                  <Library class="size-4" aria-hidden="true" />
                  노래 목록
                </NavigationMenuLink>
              </NavigationMenuItem>
              <NavigationMenuItem>
                <NavigationMenuLink href={withBase('/my-learning/')} active={learningActive}>
                  <Chart class="size-4" aria-hidden="true" />
                  내 학습
                </NavigationMenuLink>
              </NavigationMenuItem>
            </NavigationMenuList>
          </NavigationMenu>

          <ThemeToggle ariaLabel="라이트·다크 테마 전환" size="sm" />

          <Sheet>
            <SheetTrigger class="hidden size-9 place-items-center rounded-lg border border-border bg-transparent text-foreground max-[42rem]:grid" aria-label="메뉴 열기">
              <Menu class="size-5" aria-hidden="true" />
            </SheetTrigger>
            <SheetContent class="w-[min(21rem,88vw)]" side="right">
              <SheetHeader>
                <SheetTitle>HitoFushi</SheetTitle>
                <SheetDescription>공부할 노래와 내 학습 기록으로 이동합니다.</SheetDescription>
              </SheetHeader>
              <nav
                class="mt-4 grid gap-2 [&_a]:flex [&_a]:min-h-12 [&_a]:items-center [&_a]:gap-3 [&_a]:rounded-lg [&_a]:px-[0.9rem] [&_a]:py-3 [&_a]:font-[750] [&_a]:text-muted-foreground [&_a:hover]:bg-secondary [&_a:hover]:text-secondary-foreground [&_a[aria-current=page]]:bg-secondary [&_a[aria-current=page]]:text-secondary-foreground"
                aria-label="모바일 주요 메뉴"
              >
                <a href={withBase('/')}>
                  <Home class="size-5" aria-hidden="true" /> 홈
                </a>
                <a href={withBase('/songs/')} aria-current={songsActive ? 'page' : undefined}>
                  <Library class="size-5" aria-hidden="true" /> 노래 목록
                </a>
                <a href={withBase('/my-learning/')} aria-current={learningActive ? 'page' : undefined}>
                  <Chart class="size-5" aria-hidden="true" /> 내 학습
                </a>
              </nav>
            </SheetContent>
          </Sheet>
        </div>
      </PageShell>
    </header>

    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
