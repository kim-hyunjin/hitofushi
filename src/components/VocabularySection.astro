---
import type { VocabularyItem } from '../lib/types';
import FavoriteButton from './FavoriteButton';
import JapaneseSpeechButton from './JapaneseSpeechButton';
import { Card } from './starwind/card';

interface Props {
  items: VocabularyItem[];
}

const { items } = Astro.props;
---

<div class="vocabulary-list">
  {
    items.map((item) => (
      <Card class="vocabulary-item" role="article">
        <div>
          <p class="vocabulary-term">
            <strong lang="ja">{item.term}</strong>
            <span lang="ja">{item.reading}</span>
          </p>
          <p>{item.meaning}</p>
          {item.note && <small>{item.note}</small>}
        </div>
        <div class="vocabulary-actions">
          <JapaneseSpeechButton
            sentenceId={`${item.id}-vocabulary`}
            text={item.reading}
            label={`${item.term} 발음`}
            compact
            client:visible
          />
          <FavoriteButton
            vocabularyId={item.id}
            label={item.term}
            client:visible
          />
        </div>
      </Card>
    ))
  }
</div>

<style>
  .vocabulary-list {
    display: grid;
    gap: 0.65rem;
  }

  .vocabulary-item {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 84%, transparent);
  }

  .vocabulary-item p {
    margin-bottom: 0.15rem;
  }

  .vocabulary-item small {
    color: var(--ink-soft);
  }

  .vocabulary-term {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
  }

  .vocabulary-term strong {
    font-family: "Noto Serif JP", serif;
    font-size: 1.15rem;
  }

  .vocabulary-term span {
    color: var(--accent-dark);
    font-size: 0.78rem;
  }

  .vocabulary-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.4rem;
  }

  .vocabulary-item :global(.favorite-button) {
    flex: 0 0 auto;
    width: 2.5rem;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 1.25rem;
    cursor: pointer;
  }

  .vocabulary-item :global(.favorite-button.is-favorite) {
    background: color-mix(in srgb, var(--warning) 24%, var(--card));
    color: var(--accent-foreground);
  }

  @media (min-width: 42rem) {
    .vocabulary-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .vocabulary-item {
      border: 1px solid var(--line);
      border-radius: 0.9rem;
    }
  }
</style>
