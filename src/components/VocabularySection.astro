---
import type { VocabularyItem } from '../lib/types';
import FavoriteButton from './FavoriteButton';
import JapaneseSpeechButton from './JapaneseSpeechButton';
import { Card } from './starwind/card';

interface Props {
  items: VocabularyItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-[0.65rem] min-[42rem]:grid-cols-2">
  {
    items.map((item) => (
      <Card
        class="flex min-w-0 flex-row items-start justify-between gap-[0.8rem] border-0 border-b border-border bg-[color-mix(in_srgb,var(--card)_84%,transparent)] p-4 min-[42rem]:rounded-[0.9rem] min-[42rem]:border"
        role="article"
      >
        <div class="[&_p]:mb-0.5">
          <p class="flex flex-wrap items-baseline gap-[0.7rem]">
            <strong class="text-[1.15rem]" lang="ja">{item.term}</strong>
            <span class="text-[0.78rem] text-[var(--accent-dark)]" lang="ja">{item.reading}</span>
          </p>
          <p>{item.meaning}</p>
          {item.note && <small class="text-muted-foreground">{item.note}</small>}
        </div>
        <div class="flex shrink-0 items-center gap-[0.4rem]">
          <JapaneseSpeechButton
            sentenceId={`${item.id}-vocabulary`}
            text={item.reading}
            label={`${item.term} 발음`}
            compact
            client:visible
          />
          <FavoriteButton
            vocabularyId={item.id}
            label={item.term}
            client:visible
          />
        </div>
      </Card>
    ))
  }
</div>
