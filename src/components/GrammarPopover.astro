---
import { render, type CollectionEntry } from 'astro:content';
import JapaneseSpeechButton from './JapaneseSpeechButton';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogTitle,
  DialogTrigger,
} from './starwind/dialog';

interface Props {
  entry: CollectionEntry<'grammar'>;
  popoverId: string;
  variant?: 'chip' | 'index';
  sequence?: string;
}

const {
  entry,
  popoverId,
  variant = 'chip',
  sequence,
} = Astro.props;
const { Content } = await render(entry);
const titleId = `${popoverId}-title`;
---

<Dialog>
  <DialogTrigger
    class:list={[
      'cursor-pointer border-0 font-[inherit] text-foreground hover:text-[var(--accent-dark)]',
      variant === 'chip' && 'rounded-[0.45rem] bg-muted px-2 py-[0.28rem] text-xs font-bold hover:bg-secondary',
      variant === 'index' && 'grid min-h-[3.8rem] w-full grid-cols-[2.5rem_1fr_auto] items-center gap-[0.8rem] border-b border-border bg-transparent p-0 text-left [&_span]:text-xs [&_span]:text-muted-foreground [&_span:last-child]:text-base [&_span:last-child]:text-accent',
    ]}
    aria-haspopup="dialog"
  >
    {
      variant === 'index' ? (
        <>
          <span>{sequence}</span>
          <strong>{entry.data.title}</strong>
          <span aria-hidden="true">＋</span>
        </>
      ) : (
        entry.data.title
      )
    }
  </DialogTrigger>

  <DialogContent
    id={popoverId}
    class="max-h-[min(42rem,calc(100%_-_1.5rem))] w-[min(38rem,calc(100%_-_1.5rem))] overflow-y-auto rounded-xl border border-border bg-card p-0 text-foreground shadow-[0_2rem_7rem_rgb(23_50_77_/_28%)] [&_[data-slot=dialog-close]]:text-[var(--hero-foreground)]"
  >
    <header class="flex items-start justify-between gap-4 bg-[var(--hero)] px-[1.3rem] pb-4 pt-[1.3rem] text-[var(--hero-foreground)]">
      <div>
        <p class="mb-1.5 text-[0.68rem] font-[850] tracking-[0.12em] text-[var(--yellow)]">GRAMMAR · {entry.data.level}</p>
        <DialogTitle
          id={titleId}
          class="mb-0 text-[length:clamp(1.8rem,7vw,2.7rem)]! font-medium! leading-[1.12] tracking-[-0.045em] text-inherit! [font-family:Georgia,'Noto_Serif_KR',serif]"
        >
          {entry.data.title}
        </DialogTitle>
      </div>
    </header>
    <code class="mx-5 mt-5 inline-block rounded-[0.55rem] bg-secondary px-[0.7rem] py-[0.55rem] text-[0.8rem] text-accent-foreground [font-family:'Noto_Sans_JP',monospace]">{entry.data.pattern}</code>
    <DialogDescription class="mx-5 mt-4 font-bold text-muted-foreground!">{entry.data.summary}</DialogDescription>
    <div class="px-5 pt-4 [&_code]:rounded-[0.3rem] [&_code]:bg-muted [&_code]:px-[0.3rem] [&_code]:py-[0.12rem] [&_code]:text-[var(--accent-dark)] [&_p]:mb-4">
      <Content />
    </div>
    <section class="mt-[0.4rem] bg-secondary px-5 pb-[1.4rem] pt-[1.2rem]" aria-label="문법 예문">
      <p class="mb-[0.4rem] text-[0.68rem] font-[850] tracking-[0.12em] text-muted-foreground">예문</p>
      {
        entry.data.examples.map((example, index) => (
          <article class="grid gap-[0.1rem] border-t border-[rgb(23_50_77_/_16%)] py-[0.65rem]">
            <div class="flex items-center justify-between gap-[0.8rem]">
              <strong class="[font-family:'Noto_Serif_JP',serif]" lang="ja">{example.japanese}</strong>
              <JapaneseSpeechButton
                sentenceId={`${popoverId}-example-${index}`}
                text={example.japanese}
                label={`${example.japanese} 발음`}
                compact
                client:visible
              />
            </div>
            <span class="text-[0.8rem] text-muted-foreground">{example.korean}</span>
          </article>
        ))
      }
    </section>
  </DialogContent>
</Dialog>
