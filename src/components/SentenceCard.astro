---
import type { LessonSentence } from '../lib/types';
import type { CollectionEntry } from 'astro:content';
import SentenceProgress from './SentenceProgress';
import GrammarPopover from './GrammarPopover.astro';
import JapaneseSpeechButton from './JapaneseSpeechButton';
import KanjiPopover from './KanjiPopover.astro';
import { Card } from './starwind/card';

interface Props {
  sentence: LessonSentence;
  number: number;
  grammar: CollectionEntry<'grammar'>[];
  kanji: CollectionEntry<'kanji'>[];
}

const { sentence, number, grammar, kanji } = Astro.props;
const speechText = sentence.ruby
  .map((segment) => segment.reading ?? segment.text)
  .join('');
---

<Card
  class="relative overflow-hidden border border-border bg-card p-[1.35rem] before:absolute before:left-0 before:top-0 before:h-full before:w-[0.28rem] before:origin-top before:scale-y-0 before:bg-accent before:transition-transform before:duration-200 before:content-[''] hover:before:scale-y-100 min-[42rem]:p-[1.8rem]"
  role="article"
>
  <header class="mb-[1.3rem] flex items-center justify-between gap-4">
    <span class="text-base text-accent">{String(number).padStart(2, '0')}</span>
    <div class="flex flex-wrap justify-end gap-[0.45rem]">
      <JapaneseSpeechButton
        sentenceId={sentence.id}
        text={speechText}
        client:visible
      />
      <SentenceProgress sentenceId={sentence.id} client:visible />
    </div>
  </header>

  <p
    class="mb-[1.3rem] text-[length:clamp(1.45rem,6.5vw,2rem)] leading-[2] tracking-[0.025em] [&_rt]:text-[var(--accent-dark)] [html[data-reading-mode=reading]_&_rt]:invisible [html[data-reading-mode=reading]_&_ruby:focus_rt]:visible [html[data-reading-mode=reading]_&_ruby:hover_rt]:visible"
    lang="ja"
  >
    {
      sentence.ruby.map((segment) =>
        segment.reading ? (
          <ruby tabindex="0">
            {segment.text}<rt>{segment.reading}</rt>
          </ruby>
        ) : (
          segment.text
        ),
      )
    }
  </p>
  <div class="grid gap-[0.7rem]">
    <p class="m-0 grid grid-cols-[4.6rem_1fr] gap-[0.7rem] text-sm text-muted-foreground [html[data-reading-mode=elementary]_&]:hidden [html[data-reading-mode=reading]_&]:hidden" lang="ja">
      <span class="text-[0.68rem] font-extrabold text-muted-foreground">ひらがな</span>{sentence.hiragana}
    </p>
    <p class="m-0 grid grid-cols-[4.6rem_1fr] gap-[0.7rem] text-sm text-muted-foreground [html[data-reading-mode=elementary]_&]:hidden [html[data-reading-mode=reading]_&]:hidden">
      <span class="text-[0.68rem] font-extrabold text-muted-foreground">발음 도움</span>{sentence.pronunciationKo}
    </p>
    <p class="m-0 grid grid-cols-[4.6rem_1fr] gap-[0.7rem] text-sm font-bold text-foreground [html[data-show-translations=false]_&]:hidden">
      <span class="text-[0.68rem] font-extrabold text-muted-foreground">뜻</span>{sentence.translationKo}
    </p>
  </div>

  <footer class="mt-[1.35rem] grid gap-[0.8rem] border-t border-dashed border-border pt-4 min-[42rem]:grid-cols-[1fr_auto] min-[42rem]:items-start">
    <div class="flex flex-wrap items-center gap-[0.38rem]">
      <span class="w-[2.8rem] text-[0.68rem] font-extrabold text-muted-foreground">문법</span>
      {
        grammar.map((entry, index) => (
          <GrammarPopover
            entry={entry}
            popoverId={`${sentence.id}-grammar-${index}`}
          />
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-[0.38rem]">
      <span class="w-[2.8rem] text-[0.68rem] font-extrabold text-muted-foreground">한자</span>
      {
        kanji.map((entry, index) => (
          <KanjiPopover
            entry={entry}
            popoverId={`${sentence.id}-kanji-${index}`}
          />
        ))
      }
    </div>
  </footer>
</Card>
