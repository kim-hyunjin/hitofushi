---
import type { CollectionEntry } from 'astro:content';
import JapaneseSpeechButton from './JapaneseSpeechButton';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogTitle,
  DialogTrigger,
} from './starwind/dialog';

interface Props {
  entry: CollectionEntry<'kanji'>;
  popoverId: string;
  variant?: 'chip' | 'grid';
}

const {
  entry,
  popoverId,
  variant = 'chip',
} = Astro.props;
const kanji = entry.data;
const titleId = `${popoverId}-title`;
---

<Dialog>
  <DialogTrigger
    class:list={[
      'cursor-pointer border-0 font-[inherit] text-foreground',
      variant === 'chip' && 'min-w-8 rounded-[0.45rem] bg-muted px-2 py-[0.28rem] text-center text-sm hover:bg-secondary hover:text-[var(--accent-dark)]',
      variant === 'grid' && 'grid min-h-[5.2rem] w-full place-content-center border-b border-r border-border bg-card text-center hover:bg-secondary',
    ]}
    aria-haspopup="dialog"
    lang="ja"
  >
    <strong
      class:list={[
        variant === 'chip' && 'font-bold',
        variant === 'grid' && "text-[1.55rem] font-medium [font-family:'Noto_Serif_JP',serif]",
      ]}
    >{kanji.character}</strong>
    {variant === 'grid' && <span class="text-[0.65rem] text-muted-foreground">{kanji.basicMeaning.split(',')[0]}</span>}
  </DialogTrigger>

  <DialogContent
    id={popoverId}
    class="max-h-[min(44rem,calc(100%_-_1.5rem))] w-[min(42rem,calc(100%_-_1.5rem))] overflow-y-auto rounded-xl border border-border bg-card p-0 text-foreground shadow-[0_2rem_7rem_rgb(23_50_77_/_28%)] [&_[data-slot=dialog-close]]:text-[var(--hero-foreground)]"
  >
    <header class="grid grid-cols-[auto_1fr_auto] items-center gap-4 bg-[var(--hero)] p-[1.2rem] text-[var(--hero-foreground)]">
      <div class="grid aspect-square w-16 place-items-center rounded-full bg-background text-[2.5rem] text-foreground [font-family:'Noto_Serif_JP',serif]" lang="ja">{kanji.character}</div>
      <div>
        <p class="mb-1 text-[0.65rem] font-[850] tracking-[0.12em] text-[var(--yellow)]">KANJI NOTE</p>
        <DialogTitle
          id={titleId}
          class="mb-0 text-[length:clamp(1.4rem,6vw,2.4rem)]! font-medium! leading-[1.15] tracking-[-0.04em] text-inherit! [font-family:Georgia,'Noto_Serif_KR',serif]"
        >
          {kanji.basicMeaning}
        </DialogTitle>
      </div>
    </header>

    <DialogDescription class="sr-only">
      {kanji.character}의 음독, 훈독, 의미와 학습용 연상법
    </DialogDescription>

  <dl class="m-0 flex flex-wrap gap-x-[1.8rem] gap-y-[0.8rem] border-b border-border px-[1.2rem] py-4">
    <div class="flex gap-2">
      <dt class="text-[0.7rem] font-[850] text-muted-foreground">음독</dt>
      <dd class="m-0 flex flex-wrap gap-x-3 gap-y-[0.45rem] text-[0.8rem]">
        {
          kanji.onyomi.length
            ? kanji.onyomi.map((reading, index) => (
                <span class="inline-flex items-center gap-[0.3rem]">
                  <span lang="ja">{reading}</span>
                  <JapaneseSpeechButton
                    sentenceId={`${popoverId}-onyomi-${index}`}
                    text={reading}
                    label={`${reading} 발음`}
                    compact
                    client:visible
                  />
                </span>
              ))
            : '—'
        }
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-[0.7rem] font-[850] text-muted-foreground">훈독</dt>
      <dd class="m-0 flex flex-wrap gap-x-3 gap-y-[0.45rem] text-[0.8rem]">
        {
          kanji.kunyomi.length
            ? kanji.kunyomi.map((reading, index) => (
                <span class="inline-flex items-center gap-[0.3rem]">
                  <span lang="ja">{reading}</span>
                  <JapaneseSpeechButton
                    sentenceId={`${popoverId}-kunyomi-${index}`}
                    text={reading}
                    label={`${reading} 발음`}
                    compact
                    client:visible
                  />
                </span>
              ))
            : '—'
        }
      </dd>
    </div>
  </dl>

  <div class="grid gap-[0.7rem] p-[1.2rem] min-[42rem]:grid-cols-3">
    <section class="rounded-[0.8rem] border border-border p-4">
      <span class="text-accent [font-family:Georgia,serif]">01</span>
      <h3 class="mb-1 mt-[0.45rem] text-[0.95rem]">기본 의미</h3>
      <p class="mb-0 text-[0.84rem] text-muted-foreground">{kanji.basicMeaning}</p>
    </section>
    <section class="rounded-[0.8rem] border border-border p-4">
      <span class="text-accent [font-family:Georgia,serif]">02</span>
      <h3 class="mb-1 mt-[0.45rem] text-[0.95rem]">이 가사에서</h3>
      <p class="mb-0 text-[0.84rem] text-muted-foreground">{kanji.wordMeaning}</p>
    </section>
    <section class="rounded-[0.8rem] border border-border bg-secondary p-4">
      <span class="text-accent [font-family:Georgia,serif]">03</span>
      <h3 class="mb-1 mt-[0.45rem] text-[0.95rem]">기억 연상법</h3>
      <p class="mb-0 text-[0.84rem] text-muted-foreground">{kanji.mnemonic}</p>
      <small class="mt-[0.7rem] block text-accent-foreground">학습용 연상이며 실제 한자 어원 설명이 아닙니다.</small>
    </section>
  </div>

  <section class="bg-secondary p-[1.2rem]" aria-label="한자 예시 단어">
    <p class="mb-2 text-[0.68rem] font-[850] tracking-[0.12em] text-muted-foreground">함께 기억할 단어</p>
    <div>
      {
        kanji.examples.map((example, index) => (
          <article class="grid grid-cols-[minmax(4rem,auto)_1fr] gap-x-[0.8rem] border-t border-[rgb(23_50_77_/_16%)] py-[0.7rem]">
            <div class="row-span-2 flex items-center gap-[0.45rem]">
              <strong class="row-span-2 [font-family:'Noto_Serif_JP',serif]" lang="ja">{example.word}</strong>
              <JapaneseSpeechButton
                sentenceId={`${popoverId}-example-${index}`}
                text={example.reading}
                label={`${example.word} 발음`}
                compact
                client:visible
              />
            </div>
            <span class="text-xs text-[var(--accent-dark)]" lang="ja">{example.reading}</span>
            <p class="mb-0 text-[0.82rem]">{example.meaning}</p>
          </article>
        ))
      }
    </div>
  </section>
  </DialogContent>
</Dialog>
