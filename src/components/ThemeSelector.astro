<div class="theme-selector">
  <label for="site-theme">
    <span class="theme-swatch" aria-hidden="true"></span>
    <span class="theme-label">테마</span>
  </label>
  <select id="site-theme" aria-label="컬러 테마 선택">
    <option value="indigo-ume">남빛과 매화</option>
    <option value="classic">따뜻한 산호 (기존)</option>
  </select>
</div>

<script is:inline>
  (() => {
    const storageKey = 'hitofushi-theme';
    const fallbackTheme = 'indigo-ume';
    const themeColors = {
      'indigo-ume': '#26354d',
      classic: '#17324d',
    };
    const select = document.querySelector('#site-theme');

    if (!(select instanceof HTMLSelectElement)) return;

    const applyTheme = (theme) => {
      const safeTheme = theme in themeColors ? theme : fallbackTheme;
      document.documentElement.dataset.theme = safeTheme;
      select.value = safeTheme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', themeColors[safeTheme]);

      try {
        localStorage.setItem(storageKey, safeTheme);
      } catch {
        // The theme still works for this page when storage is unavailable.
      }
    };

    applyTheme(document.documentElement.dataset.theme || fallbackTheme);
    select.addEventListener('change', () => applyTheme(select.value));
  })();
</script>

<style>
  .theme-selector {
    display: flex;
    min-height: 2.35rem;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.35rem 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999rem;
    background: rgb(var(--surface-rgb) / 72%);
  }

  .theme-selector label {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .theme-swatch {
    width: 0.85rem;
    aspect-ratio: 1;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ink) 0 50%, var(--accent) 50%);
    box-shadow: 0 0 0 1px var(--line);
  }

  .theme-selector select {
    max-width: 9.5rem;
    padding: 0.28rem 1.55rem 0.28rem 0.35rem;
    border: 0;
    border-radius: 999rem;
    background-color: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 750;
  }

  .theme-selector select:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 1px;
  }

  @media (max-width: 35rem) {
    .theme-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .theme-selector select {
      max-width: 7.4rem;
    }
  }
</style>
